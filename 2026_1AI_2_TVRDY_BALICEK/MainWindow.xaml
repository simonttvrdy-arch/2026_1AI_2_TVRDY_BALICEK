<Window x:Class="_2026_1AI_2_TVRDY_BALICEK.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2026_1AI_2_TVRDY_BALICEK"
        mc:Ignorable="d"
        Title="Kartičky Gamba" Height="450" Width="520">
    <Grid Margin="0,0,0,-6">
        <Label x:Name="lblScore" Content="Body: " HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="267"/>
        <Label x:Name="lblPacks" Content="Otverených balíčkov: " HorizontalAlignment="Left" Margin="10,41,0,0" VerticalAlignment="Top" Width="267"/>
        <Label x:Name="lblMessage" Content="sus" HorizontalAlignment="Left" Margin="10,67,0,0" VerticalAlignment="Top" Width="267"/>
        <ListBox x:Name="lstCards" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,98,0,86" HorizontalAlignment="Left" Width="267"/>
        <Button x:Name="btnOpen" Content="Otvor balíček" HorizontalAlignment="Left" Margin="10,363,0,0" VerticalAlignment="Top" Click="btnOpen_Click" Height="34" Width="111"/>
        <Button x:Name="btnRestart" Content="Nová hra" HorizontalAlignment="Left" Margin="166,363,0,0" VerticalAlignment="Top" Click="btnRestart_Click" Height="34" Width="111"/>

    </Grid>
</Window>
